# The database Drizzle and better-auth run on. The URL scheme picks the dialect,
# the driver, the schema and the migration folder — there is nothing else to set:
#   file:test.db                            local SQLite file
#   libsql://<db>.turso.io                  Turso (also needs TURSO_AUTH_TOKEN)
#   postgres://user:pass@host:5432/db       PostgreSQL
#   mysql://user:pass@host:3306/db          MySQL
# Replaces the older DB_FILE_NAME.
DATABASE_URL=file:test.db

# Turso database token (`turso db tokens create <name>`). Required for a
# libsql:// URL, ignored by every other dialect, and unnecessary for `file:`.
TURSO_AUTH_TOKEN=

# Secret used by better-auth to sign sessions and OAuth continuations, and to
# encrypt Google tokens and OAuth signing keys. Treat it as immutable per
# environment; README.md documents the outage procedure for rotating it.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin the app (and therefore /api/auth/*) is served from. This is also
# the OAuth issuer identifier: use the bare origin, with no path or trailing
# slash. Changing it invalidates issued access tokens and every client's cached
# discovery documents.
BETTER_AUTH_URL=http://localhost:3000

# Kill switch for the MCP OAuth authorization server. OAuth and JWT endpoints
# are absent unless this is set to true. Keep it false until the additive
# database migration and the matching discovery routes are deployed.
MCP_OAUTH_ENABLED=false

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application).
# The same client powers both the redirect flow and Google One Tap, so it needs
# two things whitelisted:
#   "Authorized redirect URI"   <BETTER_AUTH_URL>/api/auth/callback/google
#                               local: http://localhost:3000/api/auth/callback/google
#   "Authorized JavaScript origin"  <BETTER_AUTH_URL> itself, with no path
#                               local: http://localhost:3000
# Miss the redirect URI and Google answers with redirect_uri_mismatch; miss the
# JavaScript origin and the One Tap prompt silently never appears.
# GOOGLE_CLIENT_ID also reaches the browser (it is public by design, unlike the
# secret) because One Tap initializes client-side.
# Leave both empty to run without Google sign-in; the button and the One Tap
# prompt are then both skipped.
#
# The same client also carries the Google Health grant offered on /dashboard.
# That needs two more things on the Google Cloud project, neither of which is a
# variable here:
#   - the "Google Health API" enabled under APIs & Services -> Library
#   - every scope in src/lib/google-health-scopes.ts added to the OAuth consent
#     screen. Google answers with `invalid_scope` for anything not declared
#     there, and most of these are sensitive/restricted scopes — until the
#     project is verified, only accounts listed as test users can grant them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server log verbosity: debug | info | warn | error.
# Defaults to `debug` outside production and `error` in production.
LOG_LEVEL=debug

# --- Background health sync -------------------------------------------------
#
# Off unless this is exactly `true`. It fails closed for the same reason
# MCP_OAUTH_ENABLED does, and with more at stake: the sync calls Google on
# behalf of every opted-in user without anybody asking it to, and it writes to
# cache tables a not-yet-migrated deployment does not have.
#
# Turning it on does not by itself store anyone's data. Each user opts in
# separately, from the History tab on /dashboard.
HEALTH_SYNC_ENABLED=false

# The shared secret the scheduler authenticates with, as
# `Authorization: Bearer <secret>` on /api/cron/sync and /api/cron/status.
#
# The name is not this app's choice: Vercel attaches that header to its own
# cron invocations when — and only when — a variable of exactly this name
# exists on the project. Everywhere else you send it yourself.
#
# With HEALTH_SYNC_ENABLED=true and this unset, both routes answer 503 rather
# than running unauthenticated.
CRON_SECRET=

# Wall-clock budget for one sync invocation, in milliseconds (1000-600000).
# Must sit under the platform's function timeout with room for the run to write
# its own bookkeeping. Defaults to 8000, which fits Vercel's 10s Hobby limit;
# a self-hosted deployment has no such ceiling and should raise it to 120000.
HEALTH_SYNC_BUDGET_MS=8000

# How far back the backfill reaches, in days (1-3650). Defaults to 730.
# This is also the history a cached MCP read may serve: the cache only holds
# what the sync fetched, so the floor and the read window are the same number
# by construction. A user's Google membership start date overrides it when that
# is more recent.
HEALTH_SYNC_BACKFILL_DAYS=730

# Optional comma-separated allowlist of data type ids to sync, e.g.
# `steps,sleep`. Empty means all of them. Unrecognized ids are dropped, so a
# typo narrows the sync rather than breaking start-up.
#
# This is an operator's escape hatch, not a way to say which types a user can
# read — that is discovered by probing, because Google publishes no mapping
# from data types onto consent categories.
HEALTH_SYNC_DATA_TYPES=
