# libSQL / SQLite connection string used by Drizzle and better-auth.
# Local file: `file:test.db`. Turso: `libsql://<db>.turso.io?authToken=<token>`.
DB_FILE_NAME=file:test.db

# Secret used by better-auth to sign sessions and tokens.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin the app (and therefore /api/auth/*) is served from.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application).
# Whitelist the callback as an "Authorized redirect URI", derived from
# BETTER_AUTH_URL: <BETTER_AUTH_URL>/api/auth/callback/google
#   local: http://localhost:3000/api/auth/callback/google
# Leave both empty to run without Google sign-in; the button is then hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server log verbosity: debug | info | warn | error.
# Defaults to `debug` outside production and `error` in production.
LOG_LEVEL=debug
