# Image source. Use a full sha-<commit> tag for production rollouts.
IMAGE_REGISTRY=ghcr.io/bestony
IMAGE_TAG=latest

# Only the application port is exposed on the host. Database ports stay inside
# the Compose network.
APP_PORT=3000
# Host address the application port binds to. Set 127.0.0.1 when a reverse
# proxy on the same host terminates TLS, so the plain HTTP port stays private.
APP_BIND=0.0.0.0

# Required by the application and migration service.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Use the public bare origin, without a path or trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# Required by compose.mysql.yaml and compose.postgresql.yaml. The MySQL file
# also requires MYSQL_ROOT_PASSWORD. Use URL-safe characters, or percent-encode
# the password before placing it in DATABASE_URL.
DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Keep OAuth disabled until its schema, discovery routes, and client setup are
# ready. Set to true only when the deployment is configured for MCP OAuth.
MCP_OAUTH_ENABLED=false

# Optional Google OAuth credentials. Leave both empty to use email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# debug | info | warn | error
LOG_LEVEL=info

# Optional background health sync (see README.md → Background health sync).
# Turning it on also needs `--profile sync` on every Compose command, which
# starts the sync-cron sidecar; that sidecar refuses to run without CRON_SECRET.
HEALTH_SYNC_ENABLED=false
# Generate one with: openssl rand -hex 32
CRON_SECRET=
SYNC_INTERVAL_SECONDS=600
HEALTH_SYNC_BUDGET_MS=120000
HEALTH_SYNC_BACKFILL_DAYS=730
# Comma-separated data types to sync; empty syncs every catalogued type.
HEALTH_SYNC_DATA_TYPES=
