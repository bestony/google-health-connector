# Image source. Use a full sha-<commit> tag for production rollouts.
IMAGE_REGISTRY=ghcr.io/bestony
IMAGE_TAG=latest

# Only the application port is exposed on the host. Database ports stay inside
# the Compose network.
APP_PORT=3000

# Required by the application and migration service.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Use the public bare origin, without a path or trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# Required by compose.mysql.yaml and compose.postgresql.yaml. The MySQL file
# also requires MYSQL_ROOT_PASSWORD. Use URL-safe characters, or percent-encode
# the password before placing it in DATABASE_URL.
DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Keep OAuth disabled until its schema, discovery routes, and client setup are
# ready. Set to true only when the deployment is configured for MCP OAuth.
MCP_OAUTH_ENABLED=false

# Optional Google OAuth credentials. Leave both empty to use email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# debug | info | warn | error
LOG_LEVEL=info
